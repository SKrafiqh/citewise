# Copy to .env and fill in. Never commit .env.

# Gemini (Google AI Studio): main multimodal model + embeddings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# OpenRouter: second model for verification, claim check, RAGAS judge
OPENROUTER_API_KEY=
# Pick a model from a DIFFERENT provider than Gemini (see openrouter.ai/models)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Supabase: Project "Tutor" -> Connect -> Session pooler connection string (port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# LLM response cache (makes reruns free and eval reproducible)
LLM_CACHE_DIR=.cache/llm

# Free-tier request spacing (requests per minute; 0 = off). Gemini free: 15/min/model, OpenRouter free: 20/min
GEMINI_MAX_RPM=0
OPENROUTER_MAX_RPM=0

# Retrieval gate and question dedup (tune COVERAGE_THRESHOLD with: python -m eval.run_rag_eval --tune-gate)
COVERAGE_THRESHOLD=0.6
DEDUP_THRESHOLD=0.88

# API hardening
CORS_ORIGINS=http://localhost:3000
# Ingestion endpoints are disabled until this is 16+ random characters (sent as the X-Admin-Token header):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
RATE_LIMIT_PER_MINUTE=30
# Ceiling on LLM-spending requests per day across all clients
DAILY_REQUEST_CAP=3000
# Reverse proxies in front of the API (Render = 1; local = 0)
TRUSTED_PROXY_HOPS=1
MAX_UPLOAD_MB=50

# Only for video transcription without captions (faster-whisper)
WHISPER_MODEL=small
