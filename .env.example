# Copy to .env and fill in. Never commit .env.

# Gemini (Google AI Studio) — main multimodal model + embeddings
GEMINI_API_KEY=
# Check current model names in Google AI Studio before running
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# OpenRouter — second model for verification, claim check, RAGAS judge
OPENROUTER_API_KEY=
# Pick a model from a DIFFERENT provider than Gemini (see openrouter.ai/models)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Postgres with pgvector (Supabase: Project Settings -> Database -> connection string)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# LLM response cache (makes reruns free and eval reproducible)
LLM_CACHE_DIR=.cache/llm
